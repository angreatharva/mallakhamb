{
  "name": "mallakhambindia",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": "24.x"
  },
  "type": "module",
  "scripts": {
    "looks": "node scripts/build-looks.mjs",
    "looks:check": "node scripts/build-looks.mjs --check",
    "fonts:metrics": "node scripts/font-metrics.mjs",
    "predev": "node scripts/build-looks.mjs",
    "dev": "vite",
    "dev:host": "vite --host 0.0.0.0",
    "prebuild": "node scripts/build-looks.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "lint:ci": "eslint . --quiet",
    "lint:ratchet": "node scripts/lint-ratchet.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:install:webkit": "playwright install webkit",
    "test:e2e:player": "playwright test e2e/register-player.spec.js",
    "test:e2e:player:headed": "playwright test e2e/register-player.spec.js --headed",
    "test:e2e:coach": "playwright test e2e/register-coach.spec.js",
    "test:e2e:coach:headed": "playwright test e2e/register-coach.spec.js --headed",
    "test:e2e:scoring": "playwright test e2e/score-panel.spec.js",
    "test:e2e:scoring:five": "playwright test e2e/score-panel.spec.js --grep \"five-judge\"",
    "test:e2e:scoring:four": "playwright test e2e/score-panel.spec.js --grep \"four-judge\"",
    "test:e2e:scoring:three": "playwright test e2e/score-panel.spec.js --grep \"three-judge\"",
    "test:e2e:scoring:headed": "playwright test e2e/score-panel.spec.js --headed",
    "seed:competitions": "playwright test e2e/create-competitions.spec.js",
    "seed:coaches": "playwright test e2e/register-coaches.spec.js",
    "seed:players": "playwright test e2e/register-players.spec.js",
    "seed:players:headed": "playwright test e2e/register-players.spec.js --headed",
    "seed:judges": "playwright test e2e/register-judges.spec.js",
    "seed:squads": "playwright test e2e/build-squads.spec.js",
    "seed:squads:headed": "playwright test e2e/build-squads.spec.js --headed",
    "seed:panels": "playwright test e2e/seat-panels.spec.js",
    "seed:panels:headed": "playwright test e2e/seat-panels.spec.js --headed",
    "seed:pay": "playwright test e2e/pay-entries.spec.js",
    "seed:pay:headed": "playwright test e2e/pay-entries.spec.js --headed",
    "seed:finalize": "playwright test e2e/finalize-finals.spec.js",
    "seed:scores": "playwright test e2e/score-all.spec.js --workers=2",
    "seed:scores:fast": "playwright test e2e/score-all.spec.js --workers=2 --trace=off",
    "seed:scores:one": "playwright test e2e/score-all.spec.js --workers=1 --grep \"Competition I . Male Under10\"",
    "seed:scores:headed": "playwright test e2e/score-all.spec.js --workers=1 --headed",
    "seed:ui": "playwright test e2e/register-coaches.spec.js e2e/register-players.spec.js e2e/register-judges.spec.js e2e/build-squads.spec.js e2e/seat-panels.spec.js",
    "audit:responsive": "playwright test e2e/responsive-audit.spec.js",
    "audit:tablet": "playwright test e2e/responsive-tablet.spec.js",
    "audit:modals": "playwright test e2e/responsive-modals.spec.js",
    "audit:judge-walk": "playwright test e2e/responsive-judge-walk.spec.js",
    "audit:shots": "playwright test e2e/responsive-shots.spec.js",
    "audit:visual": "playwright test e2e/visual-baseline.spec.js",
    "audit:home": "node e2e/home-device-audit.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/teko": "^5.3.0",
    "axios": "^1.6.2",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "dompurify": "^3.3.3",
    "framer-motion": "^12.23.25",
    "gsap": "3.15.0",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.546.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.48.2",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.18.2",
    "socket.io-client": "^4.7.4",
    "tailwind-merge": "^3.4.0",
    "three": "0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.36.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.4.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.32",
    "prop-types": "^15.8.1",
    "tailwindcss": "^3.3.6",
    "terser": "^5.46.0",
    "vite": "^7.1.7",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "follow-redirects": "^1.16.2"
  }
}
