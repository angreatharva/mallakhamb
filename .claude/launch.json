{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "Web",
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "start"
      ],
      "cwd": "Server",
      "port": 5000,
      "//": "Plain node, not nodemon: a watcher restarting mid-run is indistinguishable from the API being down."
    }
  ]
}
