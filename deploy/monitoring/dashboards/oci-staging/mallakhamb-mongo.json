{
  "uid": "mallakhamb-mongo",
  "title": "Mallakhamb MongoDB replica set",
  "description": "The self-hosted replica set \"mallakhamb\" (app-01, app-02, db-03): members, replication, oplog, load, disks and every backup. deploy/oci/MONGODB-SELF-HOSTED-PLAN.md §6",
  "tags": [
    "mallakhamb",
    "database",
    "mongodb",
    "oci"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "grafanacloud-sinceresloth366-prom",
          "value": "grafanacloud-prom"
        },
        "regex": "",
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "usage_datasource",
        "label": "Usage data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "grafanacloud-usage",
          "value": "grafanacloud-usage"
        },
        "regex": "/usage/",
        "hide": 2,
        "refresh": 1
      },
      {
        "name": "cpu_limit",
        "label": "CPU limit, cores (one Node event loop; OCI A1, 1 OCPU / 4 GB per VM)",
        "type": "constant",
        "query": "1",
        "hide": 2,
        "current": {
          "text": "1",
          "value": "1"
        },
        "options": [
          {
            "text": "1",
            "value": "1",
            "selected": true
          }
        ]
      },
      {
        "name": "mem_limit",
        "label": "Memory budget for the API process, bytes (1.5 GiB; OCI A1, 1 OCPU / 4 GB per VM)",
        "type": "constant",
        "query": "1610612736",
        "hide": 2,
        "current": {
          "text": "1610612736",
          "value": "1610612736"
        },
        "options": [
          {
            "text": "1610612736",
            "value": "1610612736",
            "selected": true
          }
        ]
      },
      {
        "name": "pool_max",
        "label": "MongoDB pool max (DB_POOL_MAX)",
        "type": "constant",
        "query": "100",
        "hide": 2,
        "current": {
          "text": "100",
          "value": "100"
        },
        "options": [
          {
            "text": "100",
            "value": "100",
            "selected": true
          }
        ]
      },
      {
        "name": "atlas_conn_limit",
        "label": "MongoDB connections per member: the alert line",
        "type": "constant",
        "query": "300",
        "hide": 2,
        "current": {
          "text": "300",
          "value": "300"
        },
        "options": [
          {
            "text": "300",
            "value": "300",
            "selected": true
          }
        ]
      },
      {
        "name": "sm_included",
        "label": "Synthetic check executions included per month (free tier)",
        "type": "constant",
        "query": "100000",
        "hide": 2,
        "current": {
          "text": "100000",
          "value": "100000"
        },
        "options": [
          {
            "text": "100000",
            "value": "100000",
            "selected": true
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "API restarts (deploys)",
        "enable": true,
        "iconColor": "orange",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "expr": "changes(process_start_time_seconds{scrape_job=\"mallakhamb-api-staging\"}[2m]) > 0",
        "step": "60s",
        "titleFormat": "API restarted"
      }
    ]
  },
  "links": [
    {
      "title": "Mallakhamb dashboards",
      "type": "dashboards",
      "tags": [
        "mallakhamb"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Replica set",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Primary",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(mallakhamb_mongo_primary_present{scrape_job=~\"mallakhamb-host|mallakhamb-host-standby|mallakhamb-db\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "description": "Some member sees a PRIMARY. NONE = nothing can be written (alert \"MongoDB has no primary\", critical).",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NONE",
                  "color": "red"
                },
                "1": {
                  "text": "YES",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Members answering",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "count(mallakhamb_mongo_up{scrape_job=~\"mallakhamb-host|mallakhamb-host-standby|mallakhamb-db\"} == 1) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "description": "Members whose health check (TLS + the monitor login) answered. 3 of 3 normal; 2 still writes but the next loss stops it.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Member state",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (member) (mallakhamb_mongo_member_state{scrape_job=~\"mallakhamb-host|mallakhamb-host-standby|mallakhamb-db\"})",
          "legendFormat": "{{member}}",
          "refId": "A"
        }
      ],
      "description": "Each member as the set sees it. app-01 is PRIMARY normally (priority 2); db-03 is a hidden SECONDARY that never becomes primary.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "STARTUP",
                  "color": "orange"
                },
                "1": {
                  "text": "PRIMARY",
                  "color": "green"
                },
                "2": {
                  "text": "SECONDARY",
                  "color": "green"
                },
                "3": {
                  "text": "RECOVERING",
                  "color": "orange"
                },
                "5": {
                  "text": "STARTUP2",
                  "color": "orange"
                },
                "6": {
                  "text": "UNKNOWN",
                  "color": "red"
                },
                "7": {
                  "text": "ARBITER",
                  "color": "blue"
                },
                "8": {
                  "text": "DOWN",
                  "color": "red"
                },
                "9": {
                  "text": "ROLLBACK",
                  "color": "red"
                },
                "10": {
                  "text": "REMOVED",
                  "color": "red"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Max replication lag",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(mallakhamb_mongo_replication_lag_seconds{scrape_job=~\"mallakhamb-host|mallakhamb-host-standby|mallakhamb-db\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "description": "How far the furthest member is behind the primary. Alert above 30 s for 5 m. Up to ~10 s is normal: the primary writes a no-op every 10 s when idle.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Rollback files",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(mallakhamb_mongo_rollback_files{scrape_job=~\"mallakhamb-host|mallakhamb-host-standby|mallakhamb-db\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "description": "Writes a failover undid (they had not reached a majority). Should stay 0: the app writes with w:\"majority\".",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 7,
      "type": "row",
      "title": "Replication",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Replication lag by member",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (member) (mallakhamb_mongo_replication_lag_seconds{scrape_job=~\"mallakhamb-host|mallakhamb-host-standby|mallakhamb-db\"})",
          "legendFormat": "{{member}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Member state over time",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (member) (mallakhamb_mongo_member_state{scrape_job=~\"mallakhamb-host|mallakhamb-host-standby|mallakhamb-db\"})",
          "legendFormat": "{{member}}",
          "refId": "A"
        }
      ],
      "description": "1 PRIMARY, 2 SECONDARY, 8 DOWN, 3 RECOVERING. Elections show as a primary switching to 2 while another member shows 1.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
