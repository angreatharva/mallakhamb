    {
      "id": 13,
      "type": "gauge",
      "title": "Oplog used %",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 16,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * max(mallakhamb_mongo_oplog_used_ratio{scrape_job=~\"mallakhamb-host|mallakhamb-host-standby|mallakhamb-db\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "description": "Share of the 2 GB oplog in use. Once full, the oldest entries roll off and the window below starts to count.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "orientation": "auto"
      }
    },
    {
      "id": 14,
      "type": "stat",
      "title": "Oplog window",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 4,
        "x": 20,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "min(mallakhamb_mongo_oplog_window_seconds{scrape_job=~\"mallakhamb-host|mallakhamb-host-standby|mallakhamb-db\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "description": "History the oplog holds once it is full (a member down longer than this needs a resync). Alert below 48 h.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 100000000,
                "to": 10000000000,
                "result": {
                  "text": "not full yet",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 86400
              },
              {
                "color": "green",
                "value": 172800
              }
            ]
          },
