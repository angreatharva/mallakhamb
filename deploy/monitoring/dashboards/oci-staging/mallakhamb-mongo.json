    {
      "id": 12,
      "type": "timeseries",
      "title": "Application database size",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (db) (mallakhamb_mongo_db_bytes{scrape_job=~\"mallakhamb-host|mallakhamb-host-standby|mallakhamb-db\"})",
          "legendFormat": "{{db}}",
          "refId": "A"
        }
      ],
      "description": "Data + index bytes. Plan §4a alerts at 250 MB (Atlas M0 off-site copy limit 512 MB).",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
