{
  "uid": "mallakhamb-runtime-staging",
  "title": "Mallakhamb Runtime (Node.js) (OCI staging)",
  "description": "CPU, memory, event loop and GC of the API process (one core, 3 GiB budget; OCI A1, 1 OCPU / 6 GB per VM), then the VMs themselves (Host row). Swap for jvm_* panels after the Spring Boot port. PLAN.md §3.2",
  "tags": [
    "mallakhamb",
    "runtime",
    "staging",
    "oci"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "grafanacloud-sinceresloth366-prom",
          "value": "grafanacloud-prom"
        },
        "regex": "",
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "usage_datasource",
        "label": "Usage data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "grafanacloud-usage",
          "value": "grafanacloud-usage"
        },
        "regex": "/usage/",
        "hide": 2,
        "refresh": 1
      },
      {
        "name": "cpu_limit",
        "label": "CPU limit, cores (one Node event loop; OCI A1, 1 OCPU / 6 GB per VM)",
        "type": "constant",
        "query": "1",
        "hide": 2,
        "current": {
          "text": "1",
          "value": "1"
        },
        "options": [
          {
            "text": "1",
            "value": "1",
            "selected": true
          }
        ]
      },
      {
        "name": "mem_limit",
        "label": "Memory budget for the API process, bytes (3 GiB; OCI A1, 1 OCPU / 6 GB per VM)",
        "type": "constant",
        "query": "3221225472",
        "hide": 2,
        "current": {
          "text": "3221225472",
          "value": "3221225472"
        },
        "options": [
          {
            "text": "3221225472",
            "value": "3221225472",
            "selected": true
          }
        ]
      },
      {
        "name": "pool_max",
        "label": "MongoDB pool max (DB_POOL_MAX)",
        "type": "constant",
        "query": "100",
        "hide": 2,
        "current": {
          "text": "100",
          "value": "100"
        },
        "options": [
          {
            "text": "100",
            "value": "100",
            "selected": true
          }
        ]
      },
      {
        "name": "atlas_conn_limit",
        "label": "Atlas Flex connection cap",
        "type": "constant",
        "query": "500",
        "hide": 2,
        "current": {
          "text": "500",
          "value": "500"
        },
        "options": [
          {
            "text": "500",
            "value": "500",
            "selected": true
          }
        ]
      },
      {
        "name": "sm_included",
        "label": "Synthetic check executions included per month (free tier)",
        "type": "constant",
        "query": "100000",
        "hide": 2,
        "current": {
          "text": "100000",
          "value": "100000"
        },
        "options": [
          {
            "text": "100000",
            "value": "100000",
            "selected": true
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "API restarts (deploys)",
        "enable": true,
        "iconColor": "orange",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "expr": "changes(process_start_time_seconds{scrape_job=\"mallakhamb-api-staging\"}[2m]) > 0",
        "step": "60s",
        "titleFormat": "API restarted"
      }
    ]
  },
  "links": [
    {
      "title": "Mallakhamb dashboards",
      "type": "dashboards",
      "tags": [
        "mallakhamb"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "time() - process_start_time_seconds{scrape_job=\"mallakhamb-api-staging\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "CPU % of plan",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * rate(process_cpu_seconds_total{scrape_job=\"mallakhamb-api-staging\"}[5m]) / $cpu_limit",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "description": "Process CPU as a share of one core (cpu_limit = 1): Node runs one event loop, so 100 % here is saturated whatever the VM has. Alert \"CPU saturated\" fires at 80 % for 15 m.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "orientation": "auto"
      }
    },
