{
  "uid": "mallakhamb-api-overview",
  "title": "Mallakhamb API overview",
  "description": "Is the API up, how busy, how fast, how many errors. deploy/monitoring/PLAN.md §3.1",
  "tags": [
    "mallakhamb",
    "api"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "grafanacloud-sinceresloth366-prom",
          "value": "grafanacloud-prom"
        },
        "regex": "",
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "usage_datasource",
        "label": "Usage data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "grafanacloud-usage",
          "value": "grafanacloud-usage"
        },
        "regex": "/usage/",
        "hide": 2,
        "refresh": 1
      },
      {
        "name": "cpu_limit",
        "label": "CPU limit, cores (Render free plan)",
        "type": "constant",
        "query": "0.1",
        "hide": 2,
        "current": {
          "text": "0.1",
          "value": "0.1"
        },
        "options": [
          {
            "text": "0.1",
            "value": "0.1",
            "selected": true
          }
        ]
      },
      {
        "name": "mem_limit",
        "label": "Memory limit, bytes (Render free plan, 512 MiB)",
        "type": "constant",
        "query": "536870912",
        "hide": 2,
        "current": {
          "text": "536870912",
          "value": "536870912"
        },
        "options": [
          {
            "text": "536870912",
            "value": "536870912",
            "selected": true
          }
        ]
      },
      {
        "name": "pool_max",
        "label": "MongoDB pool max (DB_POOL_MAX)",
        "type": "constant",
        "query": "100",
        "hide": 2,
        "current": {
          "text": "100",
          "value": "100"
        },
        "options": [
          {
            "text": "100",
            "value": "100",
            "selected": true
          }
        ]
      },
      {
        "name": "atlas_conn_limit",
        "label": "Atlas M0 connection cap",
        "type": "constant",
        "query": "500",
        "hide": 2,
        "current": {
          "text": "500",
          "value": "500"
        },
        "options": [
          {
            "text": "500",
            "value": "500",
            "selected": true
          }
        ]
      },
      {
        "name": "sm_included",
        "label": "Synthetic check executions included per month (free tier)",
        "type": "constant",
        "query": "100000",
        "hide": 2,
        "current": {
          "text": "100000",
          "value": "100000"
        },
        "options": [
          {
            "text": "100000",
            "value": "100000",
            "selected": true
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "API restarts (deploys)",
        "enable": true,
        "iconColor": "orange",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "expr": "changes(process_start_time_seconds{scrape_job=\"mallakhamb-api\"}[2m]) > 0",
        "step": "60s",
        "titleFormat": "API restarted"
      }
    ]
  },
  "links": [
    {
      "title": "Mallakhamb dashboards",
      "type": "dashboards",
      "tags": [
        "mallakhamb"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Up",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "up{scrape_job=\"mallakhamb-api\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "description": "Grafana Cloud scraped /metrics successfully on the last attempt.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests/s",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{scrape_job=\"mallakhamb-api\"}[5m])) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "5xx ratio (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(rate(http_server_requests_seconds_count{scrape_job=\"mallakhamb-api\",outcome=\"SERVER_ERROR\"}[5m])) or vector(0)) / clamp_min(sum(rate(http_server_requests_seconds_count{scrape_job=\"mallakhamb-api\"}[5m])), 1e-9)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "description": "Alert \"High 5xx\" fires above 2 % for 10 m (with at least 0.05 req/s).",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.005
              },
              {
                "color": "red",
                "value": 0.02
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 latency (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{scrape_job=\"mallakhamb-api\"}[5m])))",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "description": "Alert \"Slow API\" fires above 1.5 s for 10 m. \"no traffic\" = no request in the last 5 minutes.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "nan",
                "result": {
                  "text": "no traffic",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 1.5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Restarts (24h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "changes(process_start_time_seconds{scrape_job=\"mallakhamb-api\"}[24h])",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "description": "Every deploy is one restart. Several without a deploy = crash or out-of-memory (512 MB).",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 2
              },
              {
                "color": "red",
                "value": 4
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Version",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "app_info{scrape_job=\"mallakhamb-api\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "scrape_job": true,
              "instance": true,
              "Value": true
            },
            "renameByName": {
              "Value": "Value"
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Requests/s by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (outcome) (rate(http_server_requests_seconds_count{scrape_job=\"mallakhamb-api\"}[5m]))",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
