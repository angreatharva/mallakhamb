      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * rate(process_cpu_seconds_total{scrape_job=\"mallakhamb-api\"}[5m]) / $cpu_limit",
          "legendFormat": "cpu",
          "refId": "A"
        }
      ],
      "description": "Process CPU as a share of the plan allowance (cpu_limit, 0.1 core on Render free). Alert \"CPU saturated\" fires at 80 % for 15 m. Dashed lines: 70 / 80 / 90 %.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "softMax": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "dashed"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
