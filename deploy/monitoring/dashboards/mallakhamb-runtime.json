    {
      "id": 7,
      "type": "timeseries",
      "title": "Heap used / total",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "nodejs_heap_size_used_bytes{scrape_job=\"mallakhamb-api\"}",
