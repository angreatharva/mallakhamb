    {
      "id": 8,
      "type": "timeseries",
      "title": "Event-loop lag",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
