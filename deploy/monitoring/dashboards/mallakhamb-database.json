{
  "uid": "mallakhamb-database",
  "title": "Mallakhamb Database (MongoDB)",
  "description": "Connection pool always; per-command timing only while DB_MONITOR_COMMANDS=true (it costs ~25% latency). PLAN.md §3.3",
  "tags": [
    "mallakhamb",
    "database"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "grafanacloud-sinceresloth366-prom",
          "value": "grafanacloud-prom"
        },
        "regex": "",
        "hide": 0,
        "refresh": 1
      },
      {
        "name": "usage_datasource",
        "label": "Usage data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "grafanacloud-usage",
          "value": "grafanacloud-usage"
        },
        "regex": "/usage/",
        "hide": 2,
        "refresh": 1
      },
      {
        "name": "cpu_limit",
        "label": "CPU limit, cores (Render free plan)",
        "type": "constant",
        "query": "0.1",
        "hide": 2,
        "current": {
          "text": "0.1",
          "value": "0.1"
        },
        "options": [
          {
            "text": "0.1",
            "value": "0.1",
            "selected": true
          }
        ]
      },
      {
        "name": "mem_limit",
        "label": "Memory limit, bytes (Render free plan, 512 MiB)",
        "type": "constant",
        "query": "536870912",
        "hide": 2,
        "current": {
          "text": "536870912",
          "value": "536870912"
        },
        "options": [
          {
            "text": "536870912",
            "value": "536870912",
            "selected": true
          }
        ]
      },
      {
        "name": "pool_max",
        "label": "MongoDB pool max (DB_POOL_MAX)",
        "type": "constant",
        "query": "100",
        "hide": 2,
        "current": {
          "text": "100",
          "value": "100"
        },
        "options": [
          {
            "text": "100",
            "value": "100",
            "selected": true
          }
        ]
      },
      {
        "name": "atlas_conn_limit",
        "label": "Atlas M0 connection cap",
        "type": "constant",
        "query": "500",
        "hide": 2,
        "current": {
          "text": "500",
          "value": "500"
        },
        "options": [
          {
            "text": "500",
            "value": "500",
            "selected": true
          }
        ]
      },
      {
        "name": "sm_included",
        "label": "Synthetic check executions included per month (free tier)",
        "type": "constant",
        "query": "100000",
        "hide": 2,
        "current": {
          "text": "100000",
          "value": "100000"
        },
        "options": [
          {
            "text": "100000",
            "value": "100000",
            "selected": true
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "API restarts (deploys)",
        "enable": true,
        "iconColor": "orange",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "expr": "changes(process_start_time_seconds{scrape_job=\"mallakhamb-api\"}[2m]) > 0",
        "step": "60s",
        "titleFormat": "API restarted"
      }
    ]
  },
  "links": [
    {
      "title": "Mallakhamb dashboards",
      "type": "dashboards",
      "tags": [
        "mallakhamb"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Pool open",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "mongodb_driver_pool_size{scrape_job=\"mallakhamb-api\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "description": "minPoolSize is per replica-set member: DB_POOL_MIN=10 × 3 Atlas members = 30 at idle.",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "DB pool in use %",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 4,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * mongodb_driver_pool_checkedout{scrape_job=\"mallakhamb-api\"} / $pool_max",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "description": "MongoDB connections checked out as a share of DB_POOL_MAX (pool_max). Near 100 % means requests queue (alert \"DB pool waiting\").",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Atlas connections %",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 9,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * mongodb_driver_pool_size{scrape_job=\"mallakhamb-api\"} / $atlas_conn_limit",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "description": "Connections this API holds open as a share of the Atlas M0 cap (500). Other clients (scripts, Compass) count against the same cap.",
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Waiting for a connection",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "mongodb_driver_pool_waitqueuesize{scrape_job=\"mallakhamb-api\"}",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "description": "Above 0 for 10 m fires \"DB pool waiting\".",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Checkout failures (1h)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(mongodb_driver_pool_checkout_failed_total{scrape_job=\"mallakhamb-api\"}[1h])) or vector(0)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto",
        "justifyMode": "center"
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Pool in use / open",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "mongodb_driver_pool_checkedout{scrape_job=\"mallakhamb-api\"}",
          "legendFormat": "in use",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "mongodb_driver_pool_size{scrape_job=\"mallakhamb-api\"}",
          "legendFormat": "open",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Wait queue",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "mongodb_driver_pool_waitqueuesize{scrape_job=\"mallakhamb-api\"}",
          "legendFormat": "waiting",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Checkout failures by reason (15m)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (reason) (increase(mongodb_driver_pool_checkout_failed_total{scrape_job=\"mallakhamb-api\"}[15m]))",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "row",
      "title": "Per-command timing — diagnostic, off by default",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "panels": []
    },
    {
      "id": 10,
      "type": "text",
      "title": "How to use these panels",
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "options": {
        "mode": "markdown",
        "content": "These stay empty in normal running. Command monitoring makes the MongoDB driver deserialize every reply twice, which cost **~25 % latency** in the Phase 1 benchmark.\n\nTo find a slow collection: Render → `mallakhamb-server` → Environment → `DB_MONITOR_COMMANDS=true` → save (redeploys). Read these panels for up to an hour, then set it back to `false`. **Never on a competition day.**"
      }
    },
    {
      "id": 11,
      "type": "table",
      "title": "Command p95 by collection, 15m (only with DB_MONITOR_COMMANDS=true)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, command, collection) (rate(mongodb_driver_commands_seconds_bucket{scrape_job=\"mallakhamb-api\"}[15m]))) > 0)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "p95",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "scrape_job": true,
              "instance": true
            },
            "renameByName": {
              "Value": "p95"
            }
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Commands/s (only with DB_MONITOR_COMMANDS=true)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 8,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (command) (rate(mongodb_driver_commands_seconds_count{scrape_job=\"mallakhamb-api\"}[5m]))",
          "legendFormat": "{{command}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Failed commands (only with DB_MONITOR_COMMANDS=true)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 18
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (command, collection) (rate(mongodb_driver_commands_seconds_count{scrape_job=\"mallakhamb-api\",status=\"FAILED\"}[5m]))",
          "legendFormat": "{{command}} {{collection}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
