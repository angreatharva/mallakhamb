# OCI STAGING env for mallakhamb-prod-bom-vm-app-01 (COMMON.md section 5, staging column).
# Fill the <...> values, then store the WHOLE file as the Vault secret mallakhamb-prod-bom-secret-api-env
# (steps in deploy/oci/scripts/03-env-secret.md). Never commit the filled-in copy.
#
# Format rules (mallakhamb-render-env rejects anything else):
#   - one KEY='value' per line, no spaces around =, no single quote inside any value, no blank-line tricks
#   - generate secrets with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# !!! MONGODB_URI must NOT be the production database. Every deploy runs migrations
# !!! (startup.js --migrate) against it. Use a test/staging database only.

NODE_ENV='production'
PORT='5000'
CLIENT_URL='https://app-137-23-63-84.sslip.io'
FRONTEND_URL='https://app-137-23-63-84.sslip.io'
PRODUCTION_URL='https://app-137-23-63-84.sslip.io'
CORS_ORIGINS='https://app-137-23-63-84.sslip.io'

MONGODB_URI='<test database URI - NOT production>'
BACKUP_URI='<same test database; a read-only user if you have one>'
MIGRATE_ON_START='false'
DB_POOL_MIN='<copy from Render>'
DB_POOL_MAX='<copy from Render>'
DB_CONNECT_TIMEOUT='<copy from Render>'
DB_SOCKET_TIMEOUT='<copy from Render>'
DB_MONITOR_COMMANDS='false'

JWT_SECRET='<new random - not the Render one>'
JWT_EXPIRES_IN='<copy from Render>'
CSRF_ENABLED='true'
RATE_LIMIT_ENABLED='false'
METRICS_TOKEN='<new random>'

EMAIL_PROVIDER='gmail-api'
# REQUIRED with gmail-api (config-manager.js refuses to start without it): the sending Gmail address,
# i.e. the account that owns the refresh token. COMMON.md section 5 wrongly lists it as optional.
EMAIL_USER='<copy from Render>'
GMAIL_CLIENT_ID='<copy from Render>'
GMAIL_CLIENT_SECRET='<copy from Render>'
GMAIL_REFRESH_TOKEN='<copy from Render - must start with 1//>'

RAZORPAY_KEY_ID='<rzp_test_... TEST key only>'
RAZORPAY_KEY_SECRET='<matching test secret>'
DISCOUNT_CODE_ENABLED='true'
DISCOUNT_CODE='<any test code>'

KEEP_ALIVE='false'
ENABLE_API_DOCS='false'
ENABLE_DEBUG_ROUTES='false'
