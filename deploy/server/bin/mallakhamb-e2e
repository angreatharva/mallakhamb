#!/usr/bin/env bash
# deploy/oci/PLAN.md O14 — the nightly full-season lifecycle check. Run by mallakhamb-e2e.timer (root).
#
# The complete roster (15 meets, 15 teams, 140 athletes, 20 judges, 300 categories, plus the walk-in
# desk through the OCR sidecar when it answers) through the real
# API of THIS server's release, against a throw-away database, then verified and dropped:
#   1. skip on meet days (/etc/mallakhamb/NO_E2E, or the meet backup timer is on)
#   2. render /etc/mallakhamb/e2e.env = app.env + overrides. The database is the app's own with
#      "_e2e" appended (same login, same cluster), or a dedicated user's if a secret is configured;
#      it must end in "_e2e" and differ from the real one, or nothing runs
#   3. start mallakhamb-e2e-api (127.0.0.1:5001, never in Caddy) → empty the e2e database →
#      setup:api --yes (verifySeed is its last step) → empty it again → stop the API
#   4. write the result to the Alloy textfile (Grafana: "E2E failed", "E2E stale")
# Never padded or looped to raise CPU: the reclaim question is answered by alerting, not by load.
set -uo pipefail
. /etc/mallakhamb/platform.sh
. /etc/mallakhamb/e2e.conf                     # E2E_SECRET_OCID (install-e2e.sh)

REL=/opt/mallakhamb/current/Server
ENV_FILE=/etc/mallakhamb/e2e.env
PROM=/var/lib/alloy/textfile/mallakhamb_e2e.prom
PRELOAD=/usr/local/lib/mallakhamb/e2e-forwarded-https.cjs
API=http://127.0.0.1:5001
START=$(date +%s)

prev() { sed -n "s/^$1 \([0-9.]*\)$/\1/p" "$PROM" 2>/dev/null | head -1; }
write_metrics() {   # $1 exit code, $2 1 if skipped
  local ok_ts; ok_ts=$(prev mallakhamb_e2e_last_success_timestamp_seconds); ok_ts=${ok_ts:-0}
  [ "$1" = 0 ] && [ "$2" = 0 ] && ok_ts=$(date +%s)
  local code=$1; [ "$2" = 1 ] && code=$(prev mallakhamb_e2e_last_exit_code) && code=${code:-0}
  {
    echo "# HELP mallakhamb_e2e_last_run_timestamp_seconds Last time the nightly e2e timer fired (run or skip)"
    echo "# TYPE mallakhamb_e2e_last_run_timestamp_seconds gauge"
    echo "mallakhamb_e2e_last_run_timestamp_seconds $(date +%s)"
    echo "# HELP mallakhamb_e2e_last_success_timestamp_seconds Last nightly e2e run that passed verifySeed"
    echo "# TYPE mallakhamb_e2e_last_success_timestamp_seconds gauge"
    echo "mallakhamb_e2e_last_success_timestamp_seconds $ok_ts"
    echo "# HELP mallakhamb_e2e_last_exit_code Exit code of the last nightly e2e run that was not skipped (0 = passed)"
    echo "# TYPE mallakhamb_e2e_last_exit_code gauge"
    echo "mallakhamb_e2e_last_exit_code $code"
    echo "# HELP mallakhamb_e2e_last_duration_seconds Duration of the last nightly e2e attempt"
    echo "# TYPE mallakhamb_e2e_last_duration_seconds gauge"
    echo "mallakhamb_e2e_last_duration_seconds $(( $(date +%s) - START ))"
    echo "# HELP mallakhamb_e2e_skipped 1 if the last timer run was skipped (meet day)"
    echo "# TYPE mallakhamb_e2e_skipped gauge"
    echo "mallakhamb_e2e_skipped $2"
  } > "$PROM.tmp" && chown root:alloy "$PROM.tmp" && chmod 0644 "$PROM.tmp" && mv "$PROM.tmp" "$PROM"
}
finish() {   # $1 exit code
  systemctl stop mallakhamb-e2e-api 2>/dev/null || true
  write_metrics "$1" 0
  echo "E2E $( [ "$1" = 0 ] && echo PASSED || echo "FAILED (exit $1)" ) in $(( $(date +%s) - START )) s"
  exit "$1"
}
die() { echo "E2E ERROR: $*" >&2; finish "${2:-1}"; }

# 1. meet days
if [ -f /etc/mallakhamb/NO_E2E ] || systemctl is-active --quiet mallakhamb-backup-meet.timer; then
  echo "E2E SKIPPED: meet day (NO_E2E flag or the meet backup timer is on)"
  write_metrics 0 1; exit 0
fi

# 2. the environment, and the two locks on the database
db_of() { [[ "$1" =~ ^mongodb(\+srv)?://[^/]+/([^?]*) ]] && printf '%s' "${BASH_REMATCH[2]}"; }
APP_URI=$(sed -n "s/^MONGODB_URI='\(.*\)'$/\1/p" /etc/mallakhamb/app.env)
if [ -n "${E2E_SECRET_OCID:-}" ]; then
  # Optional, stronger: a dedicated Atlas user that can only reach <db>_e2e (scripts/04-e2e-secret.md).
  E2E_URI=$("$OCI" secrets secret-bundle get --secret-id "$E2E_SECRET_OCID" \
    --query 'data."secret-bundle-content".content' --raw-output | base64 -d | sed -n "s/^MONGODB_URI='\(.*\)'$/\1/p") \
    || die "could not read the e2e secret"
else
  # Default (owner decision 2026-10-16): the app's own login and cluster, database renamed to <db>_e2e.
  # Without authSource a plain mongodb:// URI authenticates against the path's database, so pin it
  # to the original before renaming; mongodb+srv (Atlas) authenticates against admin either way.
  [[ "$APP_URI" =~ ^(mongodb(\+srv)?://[^/]+/)([^?]+)(\?.*)?$ ]] || die "cannot read the database name in the app MONGODB_URI"
  base=${BASH_REMATCH[1]}; db=${BASH_REMATCH[3]}; query=${BASH_REMATCH[4]}
  if [ -z "${BASH_REMATCH[2]}" ] && [[ "$query" != *authSource=* ]]; then
    query="${query:-?}"; [ "$query" = "?" ] || query="$query&"; query="${query}authSource=$db"
  fi
  E2E_URI="${base}${db}_e2e${query}"
fi
APP_DB=$(db_of "$APP_URI"); E2E_DB=$(db_of "$E2E_URI")
[ -n "$E2E_DB" ] || die "the e2e MONGODB_URI names no database"
[[ "$E2E_DB" == *_e2e ]] || die "refusing: e2e database \"$E2E_DB\" does not end in _e2e"
[ "$E2E_DB" != "$APP_DB" ] || die "refusing: e2e database is the real one"
[[ "$E2E_URI" != *"'"* ]] || die "the e2e MONGODB_URI contains a single quote"

rnd() { openssl rand -hex "$1"; }
OVERRIDES=(
  "PORT='5001'"
  "MONGODB_URI='$E2E_URI'"
  "BACKUP_URI='$E2E_URI'"
  "MIGRATE_ON_START='false'"
  "RATE_LIMIT_ENABLED='false'"
  "EMAIL_PROVIDER='none'"
  "EMAIL_USER=''" "EMAIL_PASS=''" "GMAIL_CLIENT_ID=''" "GMAIL_CLIENT_SECRET=''" "GMAIL_REFRESH_TOKEN=''"
  "RAZORPAY_KEY_ID=''" "RAZORPAY_KEY_SECRET=''" "RAZORPAY_WEBHOOK_SECRET=''"
  "DISCOUNT_CODE_ENABLED='true'"
  "DISCOUNT_CODE='E2E$(rnd 8 | tr a-f A-F)'"
  "JWT_SECRET='$(rnd 32)'"
  "METRICS_TOKEN=''"
  "KEEP_ALIVE='false'"
  "ENABLE_DEBUG_ROUTES='false'"
  "LOG_DIR='/var/log/mallakhamb-e2e'"
  # meets.json has fixed dates; slide the season (whole weeks) so no meet is already past its end-date lock
  "SEED_SEASON_LEAD_DAYS='14'"
  # Throw-away accounts in a throw-away database: new passwords every night, kept only in this
  # root:mallakhamb 0640 file (never on a command line, where ps would show them).
  "SEED_ADMIN_PASSWORD='E2e-$(rnd 12)-Aa1!'"
  "SEED_SUPERADMIN_PASSWORD='E2e-$(rnd 12)-Aa1!'"
)
keys=$(printf '%s\n' "${OVERRIDES[@]}" | cut -d= -f1 | paste -sd'|')
tmp=$(mktemp)
{ grep -vE "^(${keys})=" /etc/mallakhamb/app.env; printf '%s\n' "${OVERRIDES[@]}"; } > "$tmp"
install -m 640 -o root -g mallakhamb "$tmp" "$ENV_FILE"; rm -f "$tmp"
install -d -m 0750 -o mallakhamb -g mallakhamb /var/log/mallakhamb-e2e /run/mallakhamb-e2e
echo "E2E: database $E2E_DB, release $(basename "$(readlink -f /opt/mallakhamb/current)" | cut -c1-7)"

# 3. the run
systemctl restart mallakhamb-e2e-api || die "mallakhamb-e2e-api did not start"
for _ in $(seq 1 40); do
  curl -fsS -H 'X-Forwarded-Proto: https' "$API/api/health/live" >/dev/null 2>&1 && break; sleep 3
done
curl -fsS -H 'X-Forwarded-Proto: https' "$API/api/health/live" >/dev/null || die "the e2e API never answered on $API"

as_app() {   # run in the release as the unprivileged user, with only the e2e environment
  runuser -u mallakhamb -- env -i PATH=/usr/bin:/bin HOME=/run/mallakhamb-e2e \
    NODE_OPTIONS="--require $PRELOAD" E2E_API_ORIGIN="$API" \
    SETUP_LOCK_PATH=/run/mallakhamb-e2e/.setup-running \
    SEED_API_URL="$API/api" PERF_BASE_URL="$API" PERF_API_URL="$API" \
    bash -c "cd '$REL' && set -a && . '$ENV_FILE' && set +a && exec \"\$@\"" _ "$@"
}
# Empty the e2e database (before and after the run). dropDatabase needs dbAdmin, which the app's own
# login may not have; then every collection is dropped instead (readWrite can). The database the
# driver actually connected to is checked again here, so a wrong URI can never empty a real one.
clean_db() {   # $1 before|after
  as_app node -e "
    const mongoose = require('mongoose');
    (async () => {
      const c = await mongoose.connect(process.env.MONGODB_URI);
      const name = c.connection.name;
      if (!/_e2e\$/.test(name)) throw new Error('refusing to empty \"' + name + '\": not an _e2e database');
      try { await c.connection.dropDatabase(); console.log('E2E: dropped ' + name + ' ($1)'); }
      catch (e) {
        if (!/not authorized|unauthorized/i.test(e.message)) throw e;
        const cols = (await c.connection.db.listCollections().toArray()).map((x) => x.name).filter((n) => !n.startsWith('system.'));
        for (const n of cols) await c.connection.db.dropCollection(n);
        console.log('E2E: emptied ' + name + ' collection by collection (' + cols.length + ', $1)');
      }
      await c.disconnect();
    })().catch((e) => { console.error('E2E: cleaning the database failed: ' + e.message); process.exit(1); });"
}

clean_db before || die "could not empty the e2e database before the run"
# No --drop: the database was just emptied above (and the chain's own drop needs dbAdmin).
as_app node scripts/setupApi.js --yes
rc=$?
# Emptied after a PASSING run only: a failed run's data stays for inspection until the next
# night, which empties it first (MONGODB-SELF-HOSTED-PLAN.md M7; alert mk-mongo-e2e-left-stg).
if [ "$rc" = 0 ]; then
  clean_db after || rc=3
else
  echo "E2E: run failed - the e2e database is kept for inspection; the next run empties it first"
fi

# 4. the walk-in desk's form reader (O15): a synthetic filled page read in-process
# with this release's virtualenv and the pinned model, on BOTH VMs, so a broken OCR
# shows up overnight rather than at the desk. Exit 9 when only this failed.
OCR=/opt/mallakhamb/current/ocr
if [ -x "$OCR/.venv/bin/python" ]; then
  tmpdir=$(runuser -u mallakhamb -- mktemp -d -p /run/mallakhamb-e2e)
  if runuser -u mallakhamb -- bash -c "cd '$REL' && node scripts/walkInFormFixture.js '$tmpdir' >/dev/null && cd '$OCR' &&        OCR_MODEL_DIR=/opt/mallakhamb/ocr-models/en_PP-OCRv5_mobile_rec .venv/bin/python -m mkwi_ocr.selftest --layout '$tmpdir/layout.json'"; then
    echo "E2E: OCR self-test passed"
  else
    echo "E2E: OCR self-test FAILED" >&2
    [ "$rc" = 0 ] && rc=9
  fi
  rm -rf "$tmpdir"
fi

finish "$rc"
