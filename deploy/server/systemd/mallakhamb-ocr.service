[Unit]
Description=Mallakhamb walk-in desk OCR sidecar (ocr/, deploy/oci/PLAN.md O15)
# Runs only where the API runs. mallakhamb.service Wants= this unit, so starting
# the API (deploy, promote) starts it; BindsTo stops it whenever the API stops
# (demote, standby). Failover therefore needs no step of its own, and the API
# always talks to the OCR on its own VM (127.0.0.1:8090).
BindsTo=mallakhamb.service
After=network-online.target

[Service]
Type=simple
User=mallakhamb
Group=mallakhamb
WorkingDirectory=/opt/mallakhamb/current/ocr
Environment=OCR_HOST=127.0.0.1
Environment=OCR_PORT=8090
Environment=OCR_THREADS=1
Environment=OCR_MODEL_DIR=/opt/mallakhamb/ocr-models/en_PP-OCRv5_mobile_rec
Environment=PYTHONUNBUFFERED=1
# OCR_TOKEN only (O15.4): set once the public ocr-... address exists for Render.
EnvironmentFile=-/etc/mallakhamb/ocr.env
ExecStart=/opt/mallakhamb/current/ocr/.venv/bin/python -m mkwi_ocr.server
Restart=on-failure
RestartSec=5
# Never at the API's expense: a hard memory ceiling, and a low CPU share so a
# photo being read on the one A1 core always yields to live scoring.
MemoryMax=1G
MemoryHigh=800M
CPUWeight=20
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/mallakhamb

[Install]
WantedBy=mallakhamb.service
