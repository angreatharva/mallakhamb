[Unit]
Description=Mallakhamb e2e lifecycle check, four slots a day (India time)
# The same timer on BOTH VMs. The runner decides by role: the ACTIVE VM takes 00:00 and 18:00 IST,
# the STANDBY 06:00 and 12:00 — so the two never run together and a failover moves the slots too.
# 00:00 finishes well before the 02:00 IST backup.

[Timer]
OnCalendar=*-*-* 00,06,12,18:00:00 Asia/Kolkata
Persistent=false
RandomizedDelaySec=0

[Install]
WantedBy=timers.target
