[Unit]
Description=Mallakhamb e2e API (internal 127.0.0.1:5001, throw-away MongoDB on 27027; deploy/oci/PLAN.md O14)
After=mallakhamb-e2e-mongod.service
# Started and stopped only by mallakhamb-e2e (the runner). Never enabled, never in Caddy;
# port 5001 is closed by the host firewall and the OCI security list.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mallakhamb
Group=mallakhamb
WorkingDirectory=/opt/mallakhamb/current/Server
# Rendered by mallakhamb-e2e before every run: app.env + overrides (PORT 5001, the throw-away database,
# EMAIL_PROVIDER=none + EMAIL_CAPTURE=true, no mail or payment credentials, a fresh JWT_SECRET, its own LOG_DIR).
EnvironmentFile=/etc/mallakhamb/e2e.env
EnvironmentFile=-/etc/mallakhamb/release.env
ExecStart=/usr/bin/node scripts/startup.js
Restart=no
KillSignal=SIGTERM
TimeoutStopSec=40
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/log/mallakhamb-e2e
