# =============================================================================
# PRODUCTION (Render) — what to set in the dashboard
# =============================================================================
#
# This is a CHECKLIST, not a file to deploy. Render injects environment
# variables from its own dashboard (render.yaml marks the secrets `sync: false`),
# so nothing here is read at runtime — copy the keys across and set the values
# there.
#
# Anything already declared in render.yaml with a literal value (NODE_ENV, PORT,
# NGROK_ENABLED) does not need setting by hand; it is listed below only so the
# full picture is in one place.
#
# NEVER commit a real .env.production. This file holds no secrets and is safe to
# track precisely because every value below is a placeholder.
# =============================================================================


# ---- Set by render.yaml already — do not duplicate in the dashboard ----------
# NODE_ENV=production
# PORT=10000
# NGROK_ENABLED=false


# ---- Required secrets: set these in the Render dashboard ---------------------

# The production cluster.
#
# MUST NOT be the same database a developer has in Server/.env. If it is, then
# `npm run prepare:db` on a laptop applies migrations to production, and
# dropping the database locally drops it for everyone. Use a separate database
# name at minimum (…/BRMC_prod), or a separate cluster.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/DATABASE?retryWrites=true&w=majority

# Signing key for access and refresh tokens. Generate a fresh one for production
# — reusing the development secret means a token minted on a laptop is valid
# against the live API. At least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_generate_a_fresh_long_random_value

# Where the deployed SPA lives. Drives the CORS allow-list and the links in
# outgoing e-mail. No trailing slash.
CLIENT_URL=https://your-frontend.onrender.com
FRONTEND_URL=https://your-frontend.onrender.com
PRODUCTION_URL=https://your-frontend.onrender.com

# Every origin allowed to call the API, comma separated. The SPA is a separate
# origin from the API, so this is not optional.
CORS_ORIGINS=https://your-frontend.onrender.com

# Payments. The webhook secret is what proves a Razorpay callback is genuine —
# without it the reconciliation endpoint cannot verify a signature.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# Outgoing e-mail (password reset OTPs). Gmail needs an APP password, not the
# account password.
EMAIL_USER=you@gmail.com
EMAIL_PASS=CHANGE_ME_app_password


# ---- Deliberately NOT set: the defaults are already correct ------------------
#
# Each of these defaults to the right value when NODE_ENV=production. They are
# listed so it is clear they were considered, not forgotten.

# Rate limiting. Defaults to ON in production. Set false ONLY to deliberately
# run an unthrottled API — judge login is the only credential-guessing surface
# on the panel, and password reset is the other. The startup log prints
# "rate limits DISABLED" when it is off.
# RATE_LIMIT_ENABLED=false

# CSRF. Defaults to ON. The SPA fetches /api/csrf-token and sends the header;
# Bearer-authenticated requests are exempt.
# CSRF_ENABLED=true

# Swagger UI. Ignored in production regardless of this value — the document maps
# every route, role and required header, and publishing it anonymously hands
# that map to everyone.
# ENABLE_API_DOCS=true

# Debug routes (/api/debug/cors, /api/debug/env). Also ignored in production.
# ENABLE_DEBUG_ROUTES=true

# Connection pool and timeouts. Defaults: min 10, max 100, connect 10s,
# socket 45s. Raise the pool only with evidence — on a free/shared tier the
# database, not the pool, is the limit.
# DB_POOL_MIN=10
# DB_POOL_MAX=100
