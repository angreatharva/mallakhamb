# =============================================================================
# Variables for the CLI scripts — NOT auto-loaded
# =============================================================================
#
# READ THIS FIRST: nothing loads this file. No script calls
# `dotenv.config({ path: '.env.scripts' })`, so setting a value here has no
# effect on its own. It is a REFERENCE for what to export in your shell, or to
# put in front of the command.
#
# It used to list five keys — API_BASE_URL, LOGIN_ENDPOINT,
# BULK_JUDGES_ENDPOINT, SUPERADMIN_EMAIL, SUPERADMIN_PASSWORD — and not one of
# them is read by anything. The scripts had been renamed to SEED_* and this file
# was never updated, so anyone following it got "SEED_ADMIN_PASSWORD is not set"
# while looking at a file that appeared to set the password.
#
# The real application environment lives in `.env` (see `.env_example`).
# =============================================================================


# -----------------------------------------------------------------------------
# scripts/seatPanel.js, scripts/seatPanels.js
# -----------------------------------------------------------------------------
#
# These seat judging panels through the REAL HTTP API rather than by writing
# documents, so the service layer's rules — the four required seats, one person
# per seat, competition scoping — still apply. The API must be running.
#
#   SEED_ADMIN_PASSWORD=... npm --prefix Server run seed:panels
#
# Windows PowerShell:
#   $env:SEED_ADMIN_PASSWORD="..."; npm --prefix Server run seed:panels

# Required. The scripts refuse to start without it rather than guess.
SEED_ADMIN_PASSWORD=

# Optional. Defaults to admin@gmail.com — the account scripts/createAdmin.js
# makes.
SEED_ADMIN_EMAIL=admin@gmail.com

# Optional. Defaults to http://127.0.0.1:5000/api.
#
# 127.0.0.1 rather than localhost on purpose: on Windows, Node's fetch resolves
# localhost to ::1 while the API listens on IPv4, and the only symptom is
# "fetch failed".
#
# Pointing this at a deployed API means these scripts will seat panels THERE.
SEED_API_URL=http://127.0.0.1:5000/api


# -----------------------------------------------------------------------------
# scripts/planPanels.js
# -----------------------------------------------------------------------------
#
# Draws the 3/4/5-judge panel sizes once, at random, into
# scripts/seed/panel-plan.json — which is committed, because both stacks read it
# and a plan that existed only on the machine that drew it would let a second
# machine seat a 4-judge panel and score it as a 5. That produces a believable
# number rather than an error, which is the worst kind.
#
# Only re-run this when you intend to redraw the plan.

# Which competition the plan is drawn for. Defaults to Mumbai.
COMPETITION_PLACE=Mumbai
