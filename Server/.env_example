# =============================================================================
# Mallakhamb API — environment
# =============================================================================
#
# THIS FILE IS THE TEMPLATE. `.env` (local) and `.env.production` (Render) must
# carry the SAME KEYS IN THE SAME ORDER as this file — only the values differ.
#
# They had drifted apart: .env had six keys this file lacked, this file had five
# .env lacked, and CORS_ORIGINS — which production cannot work without — was
# missing here entirely. `npm run env:check` compares all three and fails on any
# difference, so the drift cannot come back silently.
#
# After adding a key here, run `npm run env:check` and it will tell you exactly
# which file is missing it.
#
# Neither .env nor .env.production is committed.
# =============================================================================


# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

# development | test | staging | production
#
# This is not just a label. It decides: whether Mongoose builds schema indexes
# automatically (development only), whether rate limits are on by default,
# whether HTTPS is enforced, and whether the docs and debug routes can be
# enabled at all.
NODE_ENV=development

# Render sets this to 10000; locally 5000.
PORT=5000


# -----------------------------------------------------------------------------
# Client URLs and CORS
# -----------------------------------------------------------------------------
#
# The SPA is a SEPARATE ORIGIN from the API — a different site on the public
# suffix list, not just a different port. That is why cookies must be
# SameSite=None and why CORS is not optional.

# Where the SPA lives. Also used for links in outgoing e-mail. No trailing slash.
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
PRODUCTION_URL=http://localhost:5173

# Every origin allowed to call the API, comma separated. A missing entry here is
# the usual cause of "CORS error" in the browser console.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# The connection string.
#
# Local development and the deployed API SHOULD NOT share one database. If they
# do, `npm run prepare:db` from a laptop applies migrations to what everyone
# else is testing against, and dropping it locally drops it for all of them.
# Use at least a different database name on the same cluster.
MONGODB_URI=mongodb://127.0.0.1:27017/mallakhamb_dev

# Apply pending migrations when the server starts.
#
# `npm start` normally REPORTS what is pending and serves anyway, so a failing
# migration cannot take a running service down and two instances cannot race the
# same one. Applying belongs in a release step: `npm run prepare:db`.
#
# Set true only where there is no release step to put that in AND only one
# instance runs — Render's free tier is both (pre-deploy commands are a paid
# feature). render.yaml sets it there for exactly that reason.
#
# Leave it unset locally: run `npm run prepare:db` yourself, so you decide when
# your database changes shape.
MIGRATE_ON_START=false

# Connection pool. Raise only with evidence — on a free or shared tier the
# database, not the pool, is the limit.
DB_POOL_MIN=10
DB_POOL_MAX=100

# Milliseconds. `connect` is how long server selection waits before failing;
# `socket` is how long an idle socket is held.
DB_CONNECT_TIMEOUT=10000
DB_SOCKET_TIMEOUT=45000

# Per-command MongoDB timing (mongodb_driver_commands_seconds on /metrics).
# OFF by default and meant to stay off: with it on, the driver fully
# deserializes every reply a second time just to build the monitoring event,
# which cost ~25% p50 on the read benchmark (deploy/monitoring/PLAN.md, Phase 1
# as built). Turn on briefly to diagnose a slow database, then off again.
# Pool metrics do not need it.
DB_MONITOR_COMMANDS=false


# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------

# Signs access and refresh tokens. Use a DIFFERENT value in production — if it
# matches the development one, a token minted on a laptop is valid against the
# deployed API. At least 32 characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_generate_a_long_random_value

# Access token lifetime. The refresh token outlives it and is rotated.
JWT_EXPIRES_IN=24h


# -----------------------------------------------------------------------------
# Security switches
# -----------------------------------------------------------------------------

# CSRF (double-submit cookie). ON by default. The SPA fetches /api/csrf-token
# and sends X-CSRF-Token on state-changing requests; requests carrying an
# `Authorization: Bearer` header are exempt, because a cross-site attacker
# cannot set headers. Turn off only if a deployment genuinely cannot send it.
CSRF_ENABLED=true

# Rate limiting, as one switch.
#
# Defaults to OFF in development and test, ON in production and staging — so
# normally this line does not need to be set at all. The limits are sized for
# humans (auth is 10 requests per 15 MINUTES per IP in production) and get in
# the way of anything driving the API faster than a person clicks: the load
# harness, the e2e walk, seeding through the UI.
#
# Set true locally when you want to TEST the limiter. Set false in production
# only deliberately — judge login is the only credential-guessing surface on the
# panel, and password reset is the other. The startup report prints
# "rate limits DISABLED" when it is off.
RATE_LIMIT_ENABLED=false

# Bearer token for GET /metrics, which Grafana Cloud scrapes once a minute
# (deploy/monitoring/PLAN.md). EMPTY MEANS CLOSED: the endpoint answers 404.
# A comma-separated list lets an old and a new token overlap during a rotation.
# On Render it is set in the dashboard only (sync: false) — never commit it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
METRICS_TOKEN=


# -----------------------------------------------------------------------------
# E-mail (password reset OTPs)
# -----------------------------------------------------------------------------

# Gmail requires an APP PASSWORD here, not the account password.
EMAIL_USER=you@gmail.com
EMAIL_PASS=CHANGE_ME_app_password

# Optional Resend provider, used instead of SMTP when set.
RESEND_API_KEY=
RESEND_FROM_EMAIL=


# -----------------------------------------------------------------------------
# Payments (Razorpay)
# -----------------------------------------------------------------------------
#
# Use test keys (rzp_test_…) outside production. The webhook secret is what
# proves a callback is genuine — without it the reconciliation endpoint cannot
# verify a signature and will refuse every webhook.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=CHANGE_ME
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# Registration discount code — 100% off a coach's team entry.
#
# OFF unless you mean it. A coach who enters the right code skips Razorpay
# entirely (there is no such thing as a zero-value order) and their team is
# submitted for nothing, so anyone who learns the code enters free until this is
# switched back off. The server refuses to start with the switch on and the code
# blank, because an empty expected value matches an empty submission.
#
# The code never reaches the browser: the client is told only whether codes are
# being accepted, and every comparison happens on the server.
DISCOUNT_CODE_ENABLED=true
DISCOUNT_CODE=BRMC@2026


# -----------------------------------------------------------------------------
# Development tooling — ignored in production
# -----------------------------------------------------------------------------

# Swagger UI at /api/docs, plus the raw document at /api/docs/openapi.json.
# Never served in production regardless of this value: the document maps every
# route, role and required header, and publishing it anonymously hands that map
# to everyone.
ENABLE_API_DOCS=true

# The server URL Swagger UI's "Try it out" points at. Defaults to
# http://localhost:<PORT>. Set it when reaching the docs through a proxy.
API_PUBLIC_URL=

# /api/debug/cors and /api/debug/env. Off unless true, and never in production.
# They leak no secrets but do leak configuration, and "not production" is not a
# security boundary.
ENABLE_DEBUG_ROUTES=false

# The throwaway database the performance harness writes to
# (Server/scripts/perf/). It seeds thousands of documents and DROPS the database
# on every run, so it MUST NOT be the one in MONGODB_URI — seedScale.js refuses
# to start if the two match, or if the name does not look disposable.
PERF_MONGODB_URI=mongodb://127.0.0.1:27017/mallakhamb_perf


# -----------------------------------------------------------------------------
# ngrok tunnel (optional, local only)
# -----------------------------------------------------------------------------
#
# Exposes the local API publicly so Razorpay webhooks can reach it during
# development.
NGROK_ENABLED=false
NGROK_AUTH_TOKEN=
