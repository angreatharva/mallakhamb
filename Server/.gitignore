# Operational scripts.
#
# Ignore the *contents* of scripts/ (`scripts/*`), not the directory itself.
# The directory form (`scripts/`) excludes the directory, and git cannot
# re-include a file whose parent directory is excluded — so every `!` negation
# below would have been silently ignored. createAdmin.js and createSuperAdmin.js
# were only ever tracked because they predate this rule (LOW-1 / task 3.4).
scripts/*
!scripts/createAdmin.js
!scripts/createSuperAdmin.js
!scripts/migrate.js
!scripts/migrate-superadmin-role.js
!scripts/seedAccounts.js
!scripts/captureEnvironment.js
!scripts/planPanels.js
!scripts/seatPanel.js
!scripts/seatPanels.js
!scripts/resetScores.js

# The panel scripts and their shared plumbing. Re-including a nested file takes
# three lines, not one: `scripts/*` already excluded `scripts/lib`, and git will
# not look inside an excluded directory however many `!` lines name files in it.
!scripts/lib/
scripts/lib/*
!scripts/lib/admin-api.js
!scripts/lib/panel-plan.js

# The panel plan is a DECISION and is committed; the registration capture is a
# record of one environment and is not.
#
# scripts/seed/panel-plan.json fixes which categories get 3, 4 and 5 seats. It
# is drawn once (scripts/planPanels.js) and then read by everything that seats
# or judges a panel, including two Playwright specs — a plan that only existed
# on the machine that drew it would let a second machine seat a 4-judge panel
# and score it as a 5, which produces a believable number rather than an error.
#
# scripts/seed/registrations.generated.json is deliberately NOT allow-listed: it
# holds plaintext passwords and describes one database's state. Regenerate it
# with `npm --prefix Web run seed:ui`.
!scripts/seed/
scripts/seed/*
!scripts/seed/panel-plan.json

# The API documentation and performance harness (scripts/perf/). Same nesting
# rule as scripts/lib above: re-include the directory, exclude its contents,
# then name the files.
#
# routes.generated.json is NOT allow-listed — it is a build artefact of
# extract-routes.js, regenerated in a second from the live router, and a stale
# committed copy would be believed.
!scripts/perf/
scripts/perf/*
!scripts/perf/extract-routes.js
!scripts/perf/seedScale.js
!scripts/perf/testApi.js
!scripts/perf/benchmarkApi.js
!scripts/perf/countQueries.js
!scripts/perf/probe.js
!scripts/perf/loadTest.js
!scripts/perf/equivalence.js
!scripts/perf/socketLoad.js
!scripts/perf/lib/
scripts/perf/lib/*
!scripts/perf/lib/client.js
!scripts/perf/lib/harness-server.js

!scripts/generateOpenApi.js

# The supervised boot path. `npm start` and render.yaml's startCommand both run
# this, so leaving it ignored means the deployed service has no entry point at
# all — which is exactly what `scripts/*` did to it until a pre-merge check
# noticed the file existed on disk and not in HEAD.
!scripts/startup.js
!scripts/checkEnv.js
!scripts/createCompetitions.js
!scripts/syncDatabase.js
!scripts/setupAll.js
!scripts/meetStatus.js
